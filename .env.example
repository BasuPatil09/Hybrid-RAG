GROQ_API_KEY=
GEMINI_API_KEY=

ENVIRONMENT=development
CONSOLE_ENABLED=true
CONSOLE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

ASK_RATE_LIMIT=30/minute
INGEST_RATE_LIMIT=6/hour
EVAL_RATE_LIMIT=2/hour

GENERATION_PROVIDER=groq
GENERATION_MODEL=openai/gpt-oss-120b

JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_THINKING_LEVEL=low
JUDGE_REQUESTS_PER_MINUTE=10

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hybrid-rag
LANGSMITH_ENDPOINT=
TRACE_INCLUDE_CONTENT=true

EVAL_K_VALUES=1,3,5,10,20
RAGAS_METRICS=faithfulness,answer_relevancy,context_precision
RAGAS_JUDGE_MODEL=
RAGAS_MAX_CONCURRENCY=2

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu
CHROMA_COLLECTION_NAME=rag_chunks

OMP_NUM_THREADS=2
APP_CPUS=2
APP_MEM_LIMIT=3g